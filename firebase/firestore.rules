rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Non-Negotiable Rule: Deny ALL direct client reads and writes.
    // All database access and money-affecting operations must go through the Spring Boot backend
    // using the Firebase Admin SDK and Firestore runTransaction.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
